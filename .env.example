# Copy this file to .env and configure with your actual values

# API Configuration (You can keep this as is, or change to any secure string)
API_KEY="your_api_key_here"

# Groq Configuration (Get your API key from https://console.groq.com/)
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# External Services (Keep this URL same - it's the official hackathon endpoint)
GUVI_CALLBACK_URL=https://hackathon.guvi.in/api/updateHoneyPotFinalResult

# Conversation Settings
MAX_CONVERSATION_TURNS=20
SCAM_CONFIDENCE_THRESHOLD=0.7