# UI Backend Configuration
# Copy this to .env.ui and configure values

# Main honeypot API endpoint
HONEYPOT_API_URL=https://agentic-honey-pot-for-scam-detection-iiv4.onrender.com

# API key for authentication (must match main app)
API_KEY=team_recursives

# UI Backend server configuration
UI_BACKEND_HOST=0.0.0.0
UI_BACKEND_PORT=8001

# Streamlit configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Database
DATABASE_PATH=ui/sessions.db

# Session cleanup (days)
SESSION_CLEANUP_DAYS=7

# Logging
LOG_LEVEL=INFO
